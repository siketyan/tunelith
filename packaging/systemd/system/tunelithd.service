# tunelithd for the whole system: members of the video group use the tuners
# through /run/tunelith/tunelithd.sock.
#
# Install to /etc/systemd/system/, then `systemctl enable --now tunelithd`.
# The USB tuners need packaging/udev/90-tunelith.rules for the daemon to reach
# them.

[Unit]
Description=Tunelith daemon, sharing the tuners among programs
Documentation=https://github.com/siketyan/tunelith

[Service]
Type=exec
# Looked up in /usr/local/bin and /usr/bin, among others.
ExecStart=tunelithd --socket /run/tunelith/tunelithd.sock --socket-group video
Restart=on-failure

# A user of its own, reaching the tuners through the video group.
DynamicUser=yes
SupplementaryGroups=video
RuntimeDirectory=tunelith
RuntimeDirectoryMode=0755

ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
