# tunelithd for one user, who alone uses the tuners through
# $XDG_RUNTIME_DIR/tunelith/tunelithd.sock, where the tunelith command looks
# for it first.
#
# Install to ~/.config/systemd/user/, then `systemctl --user enable --now
# tunelithd`. The user needs access to the tuners: packaging/udev/70-tunelith.rules
# gives it to the video group and to the user logged in at the seat.

[Unit]
Description=Tunelith daemon, sharing the tuners among the programs of the user
Documentation=https://github.com/siketyan/tunelith

[Service]
Type=exec
# Looked up in /usr/local/bin and /usr/bin, among others; `systemctl --user
# edit tunelithd` to run one elsewhere, as in ~/.cargo/bin.
ExecStart=tunelithd --socket %t/tunelith/tunelithd.sock --socket-group ""
Restart=on-failure
RuntimeDirectory=tunelith

[Install]
WantedBy=default.target
